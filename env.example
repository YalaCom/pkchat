# Публичные значения для сборки сайта
PINKCHAT_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PINKCHAT_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
PINKCHAT_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
PINKCHAT_PUSH_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/send-push

# Эти значения используются только как секреты Supabase Edge Function
VAPID_PRIVATE_KEY=NEVER_PUBLISH_THIS_VALUE
VAPID_SUBJECT=mailto:you@example.com
